# ==============================
# MiniCode 配置模板
# 用法：复制本文件为 .env，然后填入你的真实密钥
#   copy .env.example .env
# ==============================

# --- 模型提供方 & 模型名 ---
# 支持的 provider：deepseek / anthropic / openai / gemini
# MINICODE_PROVIDER 不填时会根据 MINICODE_MODEL 自动推断

# 方案 A：DeepSeek（最便宜，~$0.14/M input tokens，无密钥摩擦首推）
MINICODE_PROVIDER=deepseek
MINICODE_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 方案 B：Anthropic Claude（取消上面方案 A 注释后，改用这里）
# MINICODE_PROVIDER=anthropic
# MINICODE_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-xxx

# 方案 C：OpenAI
# MINICODE_PROVIDER=openai
# MINICODE_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-xxx

# --- 预算保护（单次会话超过这个美元数会强制停止）---
MINICODE_MAX_COST=5.0

# --- WebSearch（联网搜索，需在 https://tavily.com 申请免费 key）---
TAVILY_API_KEY=tvly-your-tavily-key-here
